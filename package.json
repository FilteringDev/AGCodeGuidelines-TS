    "@types/esquery": "1.5.4",
    "@types/estraverse": "5.1.7",
    "@types/estree": "1.0.9",
    "@types/estree-jsx": "1.0.5",
    "@types/esutils": "2.0.2",
    "@types/json-schema": "7.0.15",
