{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../.cache/vendor-types",
    "tsBuildInfoFile": "../.cache/vendor-types.tsbuildinfo"
  },
  "include": [
    "types.ts",
    "core/**/*.ts",
    "jsdoc/**/*.ts",
    "react/**/*.ts",
    "import/**/*.ts",
    "import/package.json"
  ]
}
