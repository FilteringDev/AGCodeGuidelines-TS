{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "rootDir": "."
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "packages/oxlint-plugin/src/vendor.d.ts",
    "vendor/react/dependencies.d.ts",
    "vendor/import/dependencies.d.ts"
  ],
  "exclude": [
    "tests/fixtures",
    "node_modules",
    "dist"
  ]
}
